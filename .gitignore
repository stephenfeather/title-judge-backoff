# Tool metadata
.codegraph/
.claude/
.tldr/
.tldrignore
.DS_Store

# Python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.venv/
*.egg-info/

# Secrets — keys are env-only, never committed
.env
.env.*

# Data & outputs — calibration pairs contain vendor-derived titles and are
# supplied via --data; verdicts/leaderboards are run artifacts
data/*.jsonl
*.jsonl
results/
leaderboard.md
# Same reason as leaderboard.md, and easier to miss: the scenario report's
# ruling queue and deadlock tables list REAL pair ids by design. This repo is
# public, so one `git add .` would publish them.
scenario-report.md
*-report.md

# Sweep logs — the console transcript of a run: per-backend progress, and
# tracebacks carrying absolute local paths. A run artifact tied to one
# machine and one launch, superseded by the manifest, so never committed.
sweep.log
*.sweep.log

# Auto-extracted session handoffs — a machine dump of every file path and
# shell command a session touched, including absolute local paths. Hand-written
# handoffs under thoughts/shared/handoffs/main/ ARE committed; these are not.
thoughts/shared/handoffs/auto/

# Per-developer tool config. These are machine- and preference-specific, and
# several carry absolute local paths. Nothing here affects how the harness runs.
.cursor/
.gemini/
.mcp.json
GEMINI.md
opencode.jsonc
